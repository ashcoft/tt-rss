parameters:
    level: 6
    tmpDir: .phpstan-tmp
    paths:
        - .
    scanFiles:
        - lib/gettext/gettext.inc.php
        - lib/floIcon.php
        - lib/MiniTemplator.class.php
    excludePaths:
        - lib
        - node_modules (?)
        - plugins.local
        - tests
        - tests_functional
        - tests_integration
        - vendor
        - rector.php
    ignoreErrors:
        - '#Right side of && is always true#'
        - '#Right side of && is always false#'
        - '#Left side of && is always false#'
