# Snyk (https://snyk.io) policy file
# Transitive dependency vulnerabilities that cannot be directly fixed
# These are in esbuild and image-size which are pulled in by vite/vuetify

patch: {}

ignore:
  - SNYK-JS-ESBUILD-17750822:
      - '*':
          reason: "esbuild vulnerability in vite's transitive dependency. Fix requires Vite to update esbuild. Accepted risk for development build tool."
          expires: '2026-12-31T00:00:00.000Z'

  - SNYK-JS-IMAGESIZE-17295814:
      - '*':
          reason: "image-size vulnerability in less's transitive dependency used by vuetify. No fixed version available. Accepted risk for CSS processing."
          expires: '2026-12-31T00:00:00.000Z'

  - SNYK-JS-IMAGESIZE-17295816:
      - '*':
          reason: "image-size vulnerability in less's transitive dependency used by vuetify. No fixed version available. Accepted risk for CSS processing."
          expires: '2026-12-31T00:00:00.000Z'
